# MongoDB Atlas — get from mongodb.com after creating a cluster
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=

# JWT — use a long random string (openssl rand -hex 64)
PRIVATE_KEY=

# Express server port
PORT=4000

# Frontend origin (for CORS) — e.g. http://localhost:3000 in dev, your domain in prod
CLIENT_URL=http://localhost:3000

# Google OAuth — get from console.cloud.google.com
GOOGLE_CLIENT_ID=

# Stripe — get from dashboard.stripe.com
STRIPE_SECRET_KEY=
